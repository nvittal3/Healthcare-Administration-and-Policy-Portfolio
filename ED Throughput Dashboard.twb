    <worksheet name='Walkouts by ED Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Walkouts Rise Steadily as ED Stays Get Longer
</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hospitals (ED_Throughput_Scorecard)' name='federated.1mtzv710s2we7l16u31a90117dnh' />
          </datasources>
          <datasource-dependencies datasource='federated.1mtzv710s2we7l16u31a90117dnh'>
            <column caption='Walkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_0083269708693505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[op22_lwbs_pct]/100' />
            </column>
            <column caption='ED Time Band ' datatype='string' datatype-customized='true' name='[Calculation_0083269709320194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [op18b_discharged_min] &lt; 120 THEN &quot;1. Under 2 hours&quot;&#10;ELSEIF [op18b_discharged_min] &lt; 180 THEN &quot;2. 2 to 3 hours&quot;&#10;ELSEIF [op18b_discharged_min] &lt; 240 THEN &quot;3. 3 to 4 hours&quot;&#10;ELSEIF [op18b_discharged_min] &gt;= 240 THEN &quot;4. 4+ hours&quot;&#10;END' />
            </column>
            <column-instance column='[Calculation_0083269708693505]' derivation='Avg' name='[avg:Calculation_0083269708693505:qk]' pivot='key' type='quantitative' />
